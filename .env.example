# The Sorted API (SortedPay/API). Leave empty and the app shows a "not connected" screen.
VITE_API_URL=http://localhost:8787

# Privy app id. When set, sign-in goes through Privy SMS login and the user's embedded
# Solana wallet signs every outflow. When empty the app uses the API's dev sign-in
# (`dev:<mobile>` tokens, any 6-digit code), which the API refuses in production.
VITE_PRIVY_APP_ID=
